# Google Analytics 4 — ID de medición de la propiedad (Administrar → Flujos de
# datos → Flujo web). Sin esta variable el sitio funciona igual, pero no envía
# nada a Analytics.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Opcional. En desarrollo la medición está apagada para no ensuciar los datos
# reales. Poner "true" en .env.local (ignorado por git) para probar el cableado:
# los eventos aparecen en GA4 → Administrar → DebugView.
# VITE_GA_DEBUG=true

# Opcional. "denied" arranca con analytics_storage denegado (Consent Mode v2),
# para conectar un banner de cookies que luego llame a updateConsent(true).
# VITE_GA_CONSENT_DEFAULT=denied
